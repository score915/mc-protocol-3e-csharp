<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Mc3E.Client</PackageId>
    <Version>0.1.0</Version>
    <Authors>Mc3E contributors</Authors>
    <Title>MC 3E Binary Client</Title>
    <Description>Dependency-free MC protocol 3E binary TCP client for Mitsubishi MELSEC and KEYENCE KV PLCs.</Description>
    <PackageTags>PLC;MC Protocol;SLMP;MELSEC;Mitsubishi;KEYENCE;industrial automation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.ja.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
